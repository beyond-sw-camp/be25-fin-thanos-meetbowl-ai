# RabbitMQ (문서 색인/회의록 이벤트를 소비하려면 true로 설정)
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=meetbowl
RABBITMQ_PASSWORD=local-rabbitmq-password
RABBITMQ_VHOST=/
# Optional full URL override. If set, it takes precedence over host/user/password fields.
# RABBITMQ_URL=amqp://meetbowl:local-rabbitmq-password@localhost:5672/
RABBITMQ_EXCHANGE=meetbowl.topic
RABBITMQ_MINUTES_GENERATE_QUEUE=ai.minutes.generate
RABBITMQ_MINUTES_REGENERATE_QUEUE=ai.minutes.regenerate
RABBITMQ_DOCUMENT_INDEX_QUEUE=ai.index.document
RABBITMQ_DOCUMENT_INDEX_REMOVED_QUEUE=ai.index.document.removed
RABBITMQ_MINUTES_GENERATED_ROUTING_KEY=minutes.generated
RABBITMQ_MAX_RETRIES=3

# Redis feedback runtime
REDIS_FEEDBACK_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_FEEDBACK_CONSUMER_GROUP=ai-feedback
REDIS_FEEDBACK_CONSUMER_NAME=ai-local
REDIS_FEEDBACK_STREAM_MAX_LENGTH=2000
REDIS_FEEDBACK_SCAN_INTERVAL_SECONDS=1.0

# Provider credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Minutes generation
MINUTES_MODEL_PROFILE=minutes-summary
MINUTES_SUMMARY_PROVIDER=gemini
MINUTES_SUMMARY_MODEL=gemini-2.5-flash
MINUTES_SUMMARY_TEMPERATURE=0.2
MINUTES_PROMPT_VERSION=minutes-v1

# Chat
CHATBOT_MODEL_PROFILE=chatbot
CHATBOT_PROVIDER=gemini
CHATBOT_MODEL=gemini-2.5-flash
CHATBOT_TEMPERATURE=0.2
CHAT_PROMPT_VERSION=chat-v10
CHAT_THINKING_BUDGET=0
FAKE_CHAT_MODEL_NAME=fake-chat-model
FAKE_CHAT_RAG_ENABLED=false

# Embeddings and vector store
# OpenAI 키가 없으면 provider를 gemini, 모델을 gemini-embedding-001로 바꿔 GEMINI_API_KEY로 임베딩한다.
# document와 query는 반드시 같은 provider/모델/차원을 써야 검색이 맞는다.
DOCUMENT_EMBEDDING_MODEL_PROFILE=document-embedding
DOCUMENT_EMBEDDING_PROVIDER=openai
DOCUMENT_EMBEDDING_MODEL=text-embedding-3-large
DOCUMENT_EMBEDDING_DIMENSIONS=1536
QUERY_EMBEDDING_MODEL_PROFILE=query-embedding
QUERY_EMBEDDING_PROVIDER=openai
QUERY_EMBEDDING_MODEL=text-embedding-3-large
QUERY_EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meetbowl-documents-openai-large-1536

# Document indexing
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_CHUNK_STRATEGY_VERSION=paragraph-v1
# 드라이브/공유 파일(이미지·스캔 PDF) 텍스트 추출에 쓰는 Gemini 멀티모달 모델
DOCUMENT_EXTRACTION_MODEL=gemini-2.5-flash

# Object storage (드라이브/공유 워크스페이스 파일 저장소)
# 로컬은 LocalStack 엔드포인트를 쓰고, 실제 AWS는 S3_ENDPOINT를 비우면 IAM/기본 자격증명 체인을 사용한다.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=meetbowl-files
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Realtime meeting feedback
FEEDBACK_WINDOW_MAX_SEGMENTS=8
FEEDBACK_WINDOW_MAX_SECONDS=45
FEEDBACK_MIN_SEGMENTS=4
FEEDBACK_MIN_WINDOW_CHARS=40
FEEDBACK_TRIGGER_INTERVAL_SECONDS=15
FEEDBACK_COOLDOWN_SECONDS=90
FEEDBACK_STATE_TTL_SECONDS=300
FEEDBACK_SCORE_THRESHOLD=0.78
FEEDBACK_CANDIDATE_LIMIT=3

# Internal
INTERNAL_TOKEN=meetbowl-local-internal-token-32bytes
